        "\n",
        "# Vacuum Cleaner Problem\n",
        "\n",
        "rooms = {'A': 'Dirty', 'B': 'Dirty'}\n",
        "location = 'A'\n",
        "\n",
        "while 'Dirty' in rooms.values():\n",
        "    print(\"Vacuum is in room\", location)\n",
        "\n",
        "    if rooms[location] == 'Dirty':\n",
        "        print(\"Cleaning room\", location)\n",
        "        rooms[location] = 'Clean'\n",
        "\n",
        "    elif location == 'A':\n",
        "        location = 'B'\n",
        "    else:\n",
        "        location = 'A'\n",
        "\n",
        "print(\"All rooms are clean!\")\n",
        "print(rooms)\n"
