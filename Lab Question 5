        "\n",
        "from collections import deque\n",
        "\n",
        "def solve():\n",
        "    start = (3, 3, 1)\n",
        "    goal = (0, 0, 0)\n",
        "\n",
        "    queue = deque([(start, [])])\n",
        "    visited = set()\n",
        "\n",
        "    moves = [(1, 0), (2, 0), (0, 1), (0, 2), (1, 1)]\n",
        "\n",
        "    while queue:\n",
        "        state, path = queue.popleft()\n",
        "        m, c, boat = state\n",
        "\n",
        "        if state in visited:\n",
        "            continue\n",
        "        visited.add(state)\n",
        "\n",
        "        path = path + [state]\n",
        "\n",
        "        if state == goal:\n",
        "            for step in path:\n",
        "                print(step)\n",
        "            return\n",
        "\n",
        "        for dm, dc in moves:\n",
        "            if boat == 1:\n",
        "                new_state = (m - dm, c - dc, 0)\n",
        "            else:\n",
        "                new_state = (m + dm, c + dc, 1)\n",
        "\n",
        "            nm, nc, nb = new_state\n",
        "\n",
        "            if 0 <= nm <= 3 and 0 <= nc <= 3:\n",
        "                if (nm == 0 or nm >= nc) and (3 - nm == 0 or 3 - nm >= 3 - nc):\n",
        "                    if new_state not in visited:\n",
        "                        queue.append((new_state, path))\n",
        "\n",
        "    print(\"No solution found\")\n",
        "\n",
        "solve()\n"
