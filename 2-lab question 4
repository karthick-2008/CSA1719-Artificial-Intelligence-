      "source": [
        "\n",
        "# Alpha-Beta Pruning Algorithm\n",
        "\n",
        "def alphabeta(depth, node, alpha, beta, maximizing):\n",
        "    if depth == 3:\n",
        "        return node\n",
        "\n",
        "    if maximizing:\n",
        "        best = -1000\n",
        "        for value in [3, 5]:\n",
        "            score = alphabeta(depth + 1, value,\n",
        "                              alpha, beta, False)\n",
        "            best = max(best, score)\n",
        "            alpha = max(alpha, best)\n",
        "\n",
        "            if beta <= alpha:\n",
        "                break\n",
        "        return best\n",
        "\n",
        "    else:\n",
        "        best = 1000\n",
        "        for value in [3, 5]:\n",
        "            score = alphabeta(depth + 1, value,\n",
        "                              alpha, beta, True)\n",
        "            best = min(best, score)\n",
        "            beta = min(beta, best)\n",
        "\n",
        "            if beta <= alpha:\n",
        "                break\n",
        "        return best\n",
        "\n",
        "\n",
        "result = alphabeta(0, 0, -1000, 1000, True)\n",
        "print(\"Optimal value:\", result)\n"
      ]
    }
