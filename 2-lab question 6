      "source": [
        "\n",
        "import numpy as np\n",
        "from sklearn.neural_network import MLPClassifier\n",
        "\n",
        "# Input data\n",
        "X = np.array([[0, 0], [0, 1], [1, 0], [1, 1]])\n",
        "y = np.array([0, 1, 1, 1])\n",
        "\n",
        "# Create Feed Forward Neural Network\n",
        "model = MLPClassifier(\n",
        "    hidden_layer_sizes=(4,),\n",
        "    activation='relu',\n",
        "    solver='lbfgs',\n",
        "    max_iter=1000,\n",
        "    random_state=1\n",
        ")\n",
        "\n",
        "# Train the network\n",
        "model.fit(X, y)\n",
        "\n",
        "# Test the network\n",
        "prediction = model.predict([[0, 1]])\n",
        "\n",
        "print(\"Input:\", [0, 1])\n",
        "print(\"Predicted Output:\", prediction[0])\n"
      ]
    }
  ]
